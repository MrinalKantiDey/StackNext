---
/**
 * LanguageSwitcher
 *
 * Header dropdown for switching the UI language. Lists every locale defined
 * in `src/i18n/config.ts` with a flag + native name. Clicking an option
 * navigates to the same path under the chosen locale prefix.
 *
 * Follows the same pattern as ThemeSelectorDropdown — click-outside / Escape
 * to close, chevron rotates while open, persists the choice to localStorage.
 */
import { cn } from '@/lib/cn';
import { locales, defaultLocale } from '@/i18n/config';
import { getLocaleFromUrl, useTranslations, getFlagUrl } from '@/i18n/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const currentLocale =
  Astro.locals.locale
  ?? (Astro.currentLocale as string | undefined)
  ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale as any);
const active = locales.find((l) => l.code === currentLocale) ?? locales[0];

const localesJson = JSON.stringify(locales.map((l) => l.code));
---

<div
  class={cn('relative lang-dropdown-wrapper', className)}
  data-locales={localesJson}
  data-default-locale={defaultLocale}
>
  <!-- Trigger button -->
  <button
    type="button"
    class={cn(
      'lang-trigger inline-flex items-center gap-1.5 rounded-full border border-border-strong px-2.5 py-1.5',
      'text-foreground-muted hover:text-foreground hover:bg-secondary',
      'transition-colors duration-(--transition-fast)',
      'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'
    )}
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={t('switcher.aria')}
  >
    <img
      src={getFlagUrl(active.flag)}
      alt=""
      width="16"
      height="16"
      class="h-4 w-4 flex-shrink-0 rounded-[2px] object-cover"
      aria-hidden="true"
      loading="lazy"
    />
    <span class="text-xs font-semibold uppercase tracking-wide">
      {active.code}
    </span>
    <svg
      class="lang-chevron h-3 w-3 flex-shrink-0 transition-transform duration-200"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </button>

  <!-- Dropdown panel -->
  <div
    role="menu"
    aria-label={t('switcher.label')}
    class={cn(
      'lang-panel absolute right-0 top-full mt-2 z-50',
      'w-56 rounded-xl border border-border bg-background shadow-lg',
      'p-1.5',
      'hidden'
    )}
  >
    <p class="text-[10px] font-semibold uppercase tracking-wider text-foreground-muted px-2.5 py-1.5">
      {t('switcher.label')}
    </p>
    <ul class="flex flex-col gap-0.5" role="none">
      {locales.map((locale) => (
        <li role="none">
          <button
            type="button"
            class={cn(
              'lang-option group w-full flex items-center gap-2.5 rounded-lg px-2.5 py-2',
              'text-sm text-foreground-muted hover:bg-secondary hover:text-foreground',
              'transition-colors duration-(--transition-fast)',
              'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring'
            )}
            data-locale={locale.code}
            role="menuitem"
            aria-label={`${locale.label} — ${locale.nativeLabel}`}
          >
            <img
              src={getFlagUrl(locale.flag)}
              alt=""
              width="20"
              height="20"
              class="h-5 w-5 shrink-0 rounded-[3px] object-cover"
              aria-hidden="true"
              loading="lazy"
            />
            <span class="flex-1 text-left">
              <span class="block font-medium leading-tight">{locale.nativeLabel}</span>
              <span class="block text-[11px] text-foreground-subtle leading-tight">{locale.label}</span>
            </span>
            <svg
              class="lang-check h-4 w-4 text-brand-500 opacity-0 transition-opacity"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .lang-option[data-active] {
    background-color: var(--color-secondary);
    color: var(--color-foreground);
  }
  .lang-option[data-active] .lang-check {
    opacity: 1;
  }
  .lang-option[data-active] > span:nth-child(2) > span:first-child {
    font-weight: 600;
  }
</style>

<script>
  const STORAGE_KEY = 'preferred-locale';

  function localizePath(pathname: string, targetLocale: string, locales: string[], defaultLocale: string): string {
    let stripped = pathname;
    for (const code of locales) {
      if (code === defaultLocale) continue;
      if (pathname === `/${code}` || pathname === `/${code}/`) { stripped = '/'; break; }
      if (pathname.startsWith(`/${code}/`)) { stripped = pathname.slice(`/${code}`.length); break; }
    }
    if (!stripped.startsWith('/')) stripped = '/' + stripped;
    if (targetLocale === defaultLocale) return stripped;
    if (stripped === '/') return `/${targetLocale}/`;
    return `/${targetLocale}${stripped}`;
  }

  function getCurrentLocale(pathname: string, locales: string[], defaultLocale: string): string {
    const first = pathname.split('/').filter(Boolean)[0];
    if (first && locales.includes(first)) return first;
    return defaultLocale;
  }

  function initLanguageSwitcher() {
    const wrappers = document.querySelectorAll<HTMLElement>('.lang-dropdown-wrapper');
    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.dropdownInit) return;
      wrapper.dataset.dropdownInit = 'true';

      const trigger = wrapper.querySelector<HTMLButtonElement>('.lang-trigger');
      const panel = wrapper.querySelector<HTMLElement>('.lang-panel');
      const chevron = wrapper.querySelector<SVGElement>('.lang-chevron');
      if (!trigger || !panel) return;

      let locales: string[] = [];
      try { locales = JSON.parse(wrapper.dataset.locales || '[]'); } catch { locales = []; }
      const defaultLocale = wrapper.dataset.defaultLocale || 'en';
      const currentLocale = getCurrentLocale(window.location.pathname, locales, defaultLocale);

      const close = () => {
        panel.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      };

      // Mark active + bind options
      wrapper.querySelectorAll<HTMLButtonElement>('.lang-option').forEach((btn) => {
        if (btn.dataset.locale === currentLocale) btn.setAttribute('data-active', '');
        else btn.removeAttribute('data-active');

        btn.addEventListener('click', () => {
          const target = btn.dataset.locale!;
          try { localStorage.setItem(STORAGE_KEY, target); } catch { /* private mode */ }
          close();
          if (target === currentLocale) return;
          const nextUrl =
            localizePath(window.location.pathname, target, locales, defaultLocale)
            + window.location.search
            + window.location.hash;
          window.location.assign(nextUrl);
        });
      });

      // Trigger toggle — close any sibling instance first so two open panels can't coexist.
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !panel.classList.contains('hidden');
        document.querySelectorAll<HTMLElement>('.lang-dropdown-wrapper .lang-panel').forEach((p) => {
          if (p !== panel) {
            p.classList.add('hidden');
            const t = p.parentElement?.querySelector<HTMLButtonElement>('.lang-trigger');
            t?.setAttribute('aria-expanded', 'false');
            p.parentElement?.querySelector('.lang-chevron')?.classList.remove('rotate-180');
          }
        });
        if (isOpen) {
          close();
        } else {
          panel.classList.remove('hidden');
          trigger.setAttribute('aria-expanded', 'true');
          chevron?.classList.add('rotate-180');
        }
      });

      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target as Node)) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    });
  }

  initLanguageSwitcher();
  document.addEventListener('astro:page-load', initLanguageSwitcher);
  document.addEventListener('astro:after-swap', initLanguageSwitcher);
</script>
