---
/**
 * SearchTrigger
 *
 * Header search button. Opens the site-wide SearchModal (mounted once at
 * the body root in BaseLayout.astro, kept separate from <header> so its
 * `position: fixed` overlay isn't broken by the header's own
 * backdrop-filter/transform animations).
 */
import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class={cn(
    'search-trigger inline-flex items-center justify-center rounded-full p-2',
    'text-foreground-muted hover:text-foreground hover:bg-secondary',
    'transition-colors duration-(--transition-fast)',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
    className
  )}
  aria-label="Search"
  aria-haspopup="dialog"
  data-search-trigger
>
  <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/>
    <path d="m21 21-4.3-4.3"/>
  </svg>
</button>
