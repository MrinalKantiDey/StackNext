---
/**
 * Terms & Conditions page
 * URL: /terms
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';

const lastUpdated = 'August 16, 2026';
---

<PageLayout
  title="Terms & Conditions — Stacknxt Inc"
  description="The terms that govern your use of the Stacknxt Inc website and our services."
  noindex
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="file-text" size="sm" />
      Legal
    </Badge>

    <h1 slot="title">Terms & Conditions</h1>

    <p slot="description">
      Last updated: {lastUpdated}
    </p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6">
      <div class="prose prose-lg max-w-none" data-reveal>
        <p>
          These Terms & Conditions ("Terms") govern your use of the {siteConfig.name} website and any services
          you engage us for. By using our website or entering into a project agreement with us, you agree to
          these Terms.
        </p>

        <h2>Who we are</h2>
        <p>
          {siteConfig.name} is a software design and development studio based in {siteConfig.address?.city},
          {siteConfig.address?.country}. You can reach us at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
        </p>

        <h2>Use of this website</h2>
        <ul>
          <li>The content on this site is provided for general information about our services and work.</li>
          <li>You may not copy, redistribute, or use our website content for commercial purposes without written permission.</li>
          <li>You agree not to misuse the site — including attempting to disrupt it, scrape it at scale, or access areas you're not authorised to access.</li>
        </ul>

        <h2>Project engagements</h2>
        <p>
          Any design, development, or consulting work is governed by a separate written proposal or agreement
          specific to that project, which will cover scope, timeline, pricing, payment terms, and deliverables.
          Where these Terms and a signed project agreement conflict, the project agreement takes precedence for
          that engagement.
        </p>

        <h2>Intellectual property</h2>
        <ul>
          <li>Unless otherwise agreed in a project contract, ownership of final deliverables (code, designs) transfers to the client upon full payment.</li>
          <li>We retain the right to showcase completed work in our portfolio, case studies, and marketing materials, unless a client requests confidentiality and we've agreed to it in writing.</li>
          <li>Any pre-existing tools, frameworks, or proprietary components we use remain our property or that of their respective owners, and are licensed for the client's use as part of the deliverable.</li>
        </ul>

        <h2>Payment</h2>
        <p>
          Payment schedules and amounts are set out in individual project proposals. Late payments may incur
          the fees described in that proposal and may pause ongoing work until resolved.
        </p>

        <h2>Warranties and liability</h2>
        <p>
          We provide our services with reasonable skill and care. To the fullest extent permitted by law, we
          are not liable for indirect, incidental, or consequential damages arising from the use of our website
          or services. Nothing in these Terms limits liability that cannot legally be limited.
        </p>

        <h2>Third-party links</h2>
        <p>
          Our website may link to third-party websites. We're not responsible for the content, policies, or
          practices of those sites.
        </p>

        <h2>Changes to these Terms</h2>
        <p>
          We may revise these Terms from time to time. The "Last updated" date above reflects the most recent
          version. Continued use of the website after changes take effect constitutes acceptance of the revised Terms.
        </p>

        <h2>Governing law</h2>
        <p>
          These Terms are governed by the laws of {siteConfig.address?.country}, without regard to conflict-of-law
          principles, unless a signed project agreement specifies otherwise.
        </p>

        <h2>Contact us</h2>
        <p>
          Questions about these Terms? Email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> or use
          our <a href="/contact">contact page</a>.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
