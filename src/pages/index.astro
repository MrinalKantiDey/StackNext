---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import { Image } from 'astro:assets';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { Icon as AstroIcon } from 'astro-icon/components';
import BlogCard from '@/components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';
import siteConfig from '@/config/site.config';
import { getProjectSlug } from '@/lib/utils';

const projectItems = await getCollection('projects');
const featuredProjects = projectItems
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 3);

const techLogos: { name: string; icon: string }[] = [
  { name: 'Astro', icon: 'simple-icons:astro' },
  { name: 'React', icon: 'simple-icons:react' },
  { name: 'Next.js', icon: 'simple-icons:nextdotjs' },
  { name: 'TypeScript', icon: 'simple-icons:typescript' },
  { name: 'Tailwind CSS', icon: 'simple-icons:tailwindcss' },
  { name: 'Node.js', icon: 'simple-icons:nodedotjs' },
  { name: 'Vue', icon: 'simple-icons:vuedotjs' },
  { name: 'Svelte', icon: 'simple-icons:svelte' },
  { name: 'Shopify', icon: 'simple-icons:shopify' },
  { name: 'WordPress', icon: 'simple-icons:wordpress' },
  { name: 'Figma', icon: 'simple-icons:figma' },
  { name: 'Webflow', icon: 'simple-icons:webflow' },
  { name: 'Salesforce', icon: 'simple-icons:salesforce' },
  { name: 'Vercel', icon: 'simple-icons:vercel' },
];
const marqueeLogos = [...techLogos, ...techLogos];
---

<LandingLayout
  title="We build AI-Powered Websites, Mobile and Web Apps"
  description="Stacknxt is a AI-Powered full-cycle mobile and web development company. We offer a full range of services: from software development, design and support to the product strategy and launch."
  image="/og-default.svg"
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" showScrollIndicator>
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">Available for new projects</Badge>

    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">We Are —</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">
        <TypingEffect words={["App Developer", "Web Designer", "Web Developer", "Astro Developer", "Vibe Coder", "Salesforce Developer", "UI / UX Enthusiast", "Blogger", "Coffee lover"]} />
      </span>
    </h1>

    <p slot="description">
      For startups, SMEs, and enterprises. Business-results oriented & AI-powered 🚀
    </p>

   <Fragment slot="actions">
      <Button size="lg" href="/projects">
        View Portfolio
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href="/contact">
        <Icon name="rocket" size="sm" />
        Get A Quote
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Logo Marquee -->
  <section class="logo-marquee relative z-10 overflow-hidden bg-background border-t border-border py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col items-center gap-3 text-center mb-8" data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground-muted">
          Tools & technologies we work with
        </span>
        <div class="h-px w-12 bg-gradient-to-r from-transparent via-brand-500 to-transparent"></div>
      </div>
    </div>

    <div class="logo-marquee__viewport relative">
      <div class="logo-marquee__track flex w-max items-center gap-12 md:gap-16 py-2">
        {marqueeLogos.map((logo, i) => (
          <div
            class="logo-marquee__item group flex items-center gap-3 shrink-0"
            aria-hidden={i >= techLogos.length ? 'true' : undefined}
          >
            <AstroIcon
              name={logo.icon}
              class="h-8 w-8 md:h-9 md:w-9 text-foreground-muted/70 transition-all duration-300 group-hover:text-brand-500 group-hover:scale-110"
              aria-hidden="true"
            />
            <span class="hidden sm:inline text-sm font-medium text-foreground-muted/80 transition-colors duration-300 group-hover:text-foreground whitespace-nowrap">
              {logo.name}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .logo-marquee__viewport {
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
              mask-image: linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
    }
    .logo-marquee__track {
      animation: logo-marquee-scroll 40s linear infinite;
      will-change: transform;
    }
    .logo-marquee:hover .logo-marquee__track {
      animation-play-state: paused;
    }
    @keyframes logo-marquee-scroll {
      from { transform: translate3d(0, 0, 0); }
      to   { transform: translate3d(-50%, 0, 0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-marquee__track {
        animation: none;
        transform: none;
        flex-wrap: wrap;
        justify-content: center;
      }
      .logo-marquee__viewport {
        -webkit-mask-image: none;
                mask-image: none;
      }
    }
  </style>

  <!-- Services Section -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Our Expertise</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            What we offer
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          From concept to launch.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Web Design -->
        <Card hover data-reveal>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="layout" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Web Design</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Clean, modern interfaces that look great on every screen. Focused on clarity, usability, and your brand identity.
              </p>
            </div>
          </div>
        </Card>

        <!-- Web Development -->
        <Card hover data-reveal data-reveal-delay="1">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="code" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Web Development</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Fast, accessible websites built with modern tooling. Astro, Tailwind, and best-practice architecture from day one.
              </p>
            </div>
          </div>
        </Card>

        <!-- Performance -->
        <Card hover data-reveal data-reveal-delay="2">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <Icon name="zap" size="sm" />
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Performance Optimization</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Core Web Vitals, SEO, and page speed — built in from the start, not bolted on at the end.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

 <!-- About Teaser -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col justify-center" data-reveal="right">
          <div class="flex flex-col gap-6 mb-6">
            <Badge variant="brand" pill class="self-start">100+ in-house specialists</Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              Let's, Stack your <br />
              <span class="text-brand-500">SaaS, PaaS and App Together.</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4">
           Sixteen years of hands-on experience{siteConfig.address?.city ? `, based in ${siteConfig.address.city}${siteConfig.address.country ? `, ${siteConfig.address.country}` : ''}` : ''} and available for clients worldwide. We build a long-term relationship with our clients and offer a full range of services: from project discovery, software development, and design to product launch and support.
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-8">
           At Stacknxt, we are dedicated to the success of your business by leveraging technology potential.
          </p>
           <Button variant="outline" href="/about" class="self-start">
            About Us
          </Button>
        </div>
        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal="left" data-reveal-delay="1">
          <p class="text-sm text-foreground mb-5 text-center">Ready To Evolve Your Business With Smarter Tech?</p>
          <div class="grid grid-cols-2 gap-3 flex-1 auto-rows-fr">
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="history" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">16 Years Experience</p>
            </div>
            <a href="https://nextjs.org/" target="_blank" rel="noopener noreferrer" class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 h-full">
              <svg class="w-10 h-10 text-brand-500" viewBox="0 0 1280 1280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M815.039 94.6439C824.758 106.709 829.714 122.99 839.626 155.553L1056.17 866.901C976.107 825.368 889.072 795.413 797.281 779.252L656.29 302.798C653.983 295.002 646.822 289.654 638.693 289.654C630.542 289.654 623.368 295.03 621.08 302.853L481.795 779.011C389.579 795.1 302.146 825.109 221.741 866.793L439.347 155.388L439.348 155.388C449.291 122.882 454.262 106.629 463.982 94.5853C472.562 83.9531 483.723 75.6958 496.4 70.6002C510.76 64.8284 527.756 64.8284 561.749 64.8284H717.174C751.212 64.8284 768.23 64.8284 782.603 70.6123C795.292 75.7184 806.459 83.9923 815.039 94.6439Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M840.951 900.754C805.253 931.279 734.002 952.097 651.929 952.097C551.197 952.097 466.767 920.737 444.363 878.561C436.354 902.732 434.558 930.396 434.558 948.068C434.558 948.068 429.281 1034.84 489.636 1095.2C489.636 1063.86 515.042 1038.46 546.381 1038.46C600.097 1038.46 600.036 1085.32 599.987 1123.34C599.986 1124.48 599.984 1125.61 599.984 1126.73C599.984 1184.44 635.255 1233.91 685.416 1254.77C677.924 1239.36 673.721 1222.05 673.721 1203.77C673.721 1148.73 706.034 1128.23 743.588 1104.41L743.588 1104.41C773.469 1085.46 806.668 1064.41 829.548 1022.17C841.486 1000.13 848.265 974.893 848.265 948.068C848.265 931.573 845.702 915.676 840.951 900.754Z" fill="currentColor"/>
              </svg>
              <p class="text-sm font-semibold text-foreground">Modern Tech Stack</p>
            </a>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="globe" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Global Teams</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="map-pin" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">Based in <br class="sm:hidden" />{siteConfig.address?.city ?? 'Your City'}{siteConfig.address?.country ? `, ${siteConfig.address.country}` : ''}</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Portfolio Carousel -->
  <section id="work" class="portfolio-carousel relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Selected works</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            Featured Projects
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          A selection of recent work — swipe through to explore.
        </p>
      </div>

      <!-- Carousel header: controls -->
      <div class="flex items-center justify-between gap-4" data-reveal>
        <p class="text-sm text-foreground-muted">
          <span class="portfolio-carousel__counter font-semibold text-foreground">1</span>
          <span class="opacity-60">/ {featuredProjects.length}</span>
        </p>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="portfolio-carousel__btn portfolio-carousel__btn--prev w-11 h-11 rounded-full border border-border bg-background flex items-center justify-center text-foreground transition-all duration-200 hover:bg-brand-500 hover:border-brand-500 hover:text-white hover:-translate-x-0.5 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-background disabled:hover:text-foreground disabled:hover:border-border disabled:hover:translate-x-0"
            aria-label="Previous project"
          >
            <Icon name="arrow-left" size="sm" />
          </button>
          <button
            type="button"
            class="portfolio-carousel__btn portfolio-carousel__btn--next w-11 h-11 rounded-full border border-border bg-background flex items-center justify-center text-foreground transition-all duration-200 hover:bg-brand-500 hover:border-brand-500 hover:text-white hover:translate-x-0.5 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-background disabled:hover:text-foreground disabled:hover:border-border disabled:hover:translate-x-0"
            aria-label="Next project"
          >
            <Icon name="arrow-right" size="sm" />
          </button>
        </div>
      </div>
    </div>

    <!-- Carousel track -->
    <div class="portfolio-carousel__viewport mt-6">
      <div
        class="portfolio-carousel__track flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth px-6 pb-4"
        role="region"
        aria-roledescription="carousel"
        aria-label="Featured projects"
        tabindex="0"
      >
        {featuredProjects.map((project, i) => {
          const slug = getProjectSlug(project);
          const href = `/projects/${slug}`;
          return (
            <article
              class="portfolio-carousel__slide group snap-start shrink-0 w-[88%] sm:w-[60%] md:w-[46%] lg:w-[36%]"
              aria-label={`${i + 1} of ${featuredProjects.length}: ${project.data.title}`}
              data-index={i}
              data-reveal
            >
              <Card variant="elevated" padding="none" class="group/card overflow-hidden flex flex-col h-full transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
                <a href={href} class="block overflow-hidden bg-background-tertiary aspect-[16/10] relative" aria-hidden="true" tabindex="-1">
                  {project.data.image ? (
                    <Image
                      src={project.data.image}
                      alt={project.data.imageAlt || project.data.title}
                      widths={[480, 768, 960]}
                      sizes="(max-width: 640px) 88vw, (max-width: 768px) 60vw, (max-width: 1024px) 46vw, 36vw"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-brand-500/15 via-background-tertiary to-background">
                      <Icon name="layers" class="w-12 h-12 text-brand-500/60" />
                    </div>
                  )}
                  {project.data.year && (
                    <span class="absolute top-3 right-3 text-xs font-medium text-foreground bg-background/80 backdrop-blur-sm px-2.5 py-1 rounded-full border border-border">
                      {project.data.year}
                    </span>
                  )}
                </a>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="font-display text-xl font-bold text-foreground mb-2">
                    <a href={href} class="hover:text-brand-500 transition-colors">
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1 line-clamp-3">
                    {project.data.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5 mb-5">
                    {project.data.tags.slice(0, 3).map((tag) => (
                      <Badge variant="brand">{tag}</Badge>
                    ))}
                  </div>
                  <a
                    href={href}
                    class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-500 hover:text-brand-600 transition-colors self-start group/link"
                  >
                    Read case study
                    <Icon name="arrow-right" size="sm" class="transition-transform group-hover/link:translate-x-1" />
                  </a>
                </div>
              </Card>
            </article>
          );
        })}
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-6 mt-10 flex flex-col items-center gap-4">
      <div class="portfolio-carousel__dots flex gap-2" role="tablist" aria-label="Project slides">
        {featuredProjects.map((_, i) => (
          <button
            type="button"
            class="portfolio-carousel__dot w-2 h-2 rounded-full bg-foreground-muted/30 transition-all duration-300 hover:bg-foreground-muted/60"
            data-index={i}
            role="tab"
            aria-label={`Go to project ${i + 1}`}
          ></button>
        ))}
      </div>
      <Button variant="outline" href="/projects" class="mt-2">
        View all projects
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </section>

  <style>
    .portfolio-carousel__track {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .portfolio-carousel__track::-webkit-scrollbar { display: none; }
    .portfolio-carousel__track > * { scroll-margin-left: 1.5rem; }
    .portfolio-carousel__dot[data-active="true"] {
      width: 1.5rem;
      background: var(--color-brand-500);
    }
    .portfolio-carousel__track:focus-visible {
      outline: 2px solid var(--color-brand-500);
      outline-offset: 4px;
      border-radius: 0.5rem;
    }
    @media (prefers-reduced-motion: reduce) {
      .portfolio-carousel__track { scroll-behavior: auto; }
    }
  </style>

  <script>
    function initPortfolioCarousel() {
      const root = document.querySelector<HTMLElement>('.portfolio-carousel');
      if (!root) return;
      const track = root.querySelector<HTMLElement>('.portfolio-carousel__track');
      const prevBtn = root.querySelector<HTMLButtonElement>('.portfolio-carousel__btn--prev');
      const nextBtn = root.querySelector<HTMLButtonElement>('.portfolio-carousel__btn--next');
      const counter = root.querySelector<HTMLElement>('.portfolio-carousel__counter');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.portfolio-carousel__dot'));
      const slides = track ? Array.from(track.querySelectorAll<HTMLElement>('.portfolio-carousel__slide')) : [];
      if (!track || slides.length === 0) return;

      const getSlideWidth = () => {
        if (slides.length < 2) return slides[0].getBoundingClientRect().width;
        const a = slides[0].getBoundingClientRect();
        const b = slides[1].getBoundingClientRect();
        return b.left - a.left;
      };

      const getCurrentIndex = () => {
        const slideWidth = getSlideWidth();
        if (!slideWidth) return 0;
        return Math.round(track.scrollLeft / slideWidth);
      };

      const update = () => {
        const idx = Math.max(0, Math.min(slides.length - 1, getCurrentIndex()));
        if (counter) counter.textContent = String(idx + 1);
        dots.forEach((dot, i) => {
          if (i === idx) dot.setAttribute('data-active', 'true');
          else dot.removeAttribute('data-active');
        });
        if (prevBtn) prevBtn.disabled = track.scrollLeft <= 4;
        if (nextBtn) nextBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };

      const scrollByOne = (dir: 1 | -1) => {
        track.scrollBy({ left: dir * getSlideWidth(), behavior: 'smooth' });
      };

      prevBtn?.addEventListener('click', () => scrollByOne(-1));
      nextBtn?.addEventListener('click', () => scrollByOne(1));
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          track.scrollTo({ left: i * getSlideWidth(), behavior: 'smooth' });
        });
      });

      track.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); scrollByOne(1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); scrollByOne(-1); }
      });

      let ticking = false;
      track.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      }, { passive: true });

      window.addEventListener('resize', update);
      update();
    }

    initPortfolioCarousel();
    document.addEventListener('astro:page-load', initPortfolioCarousel);
  </script>

  <!-- Testimonials -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Testimonials</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            What our clients are saying
