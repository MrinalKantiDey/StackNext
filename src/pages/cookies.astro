---
/**
 * Cookie Policy page
 * URL: /cookies
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';
import consentConfig from '@/config/consent.config';

const lastUpdated = 'August 16, 2026';
const categoryEntries = Object.entries(consentConfig.categories);

const exampleCookies: Record<string, { name: string; purpose: string; duration: string }[]> = {
  necessary: [
    { name: consentConfig.storageKey, purpose: 'Stores your cookie consent preferences.', duration: '1 year (localStorage)' },
  ],
  analytics: [
    { name: '_ga, _ga_*', purpose: 'Google Analytics — distinguishes unique visitors.', duration: 'Up to 2 years' },
    { name: '_gid', purpose: 'Google Analytics — distinguishes visitors within a 24-hour window.', duration: '24 hours' },
  ],
  marketing: [
    { name: '_gcl_au', purpose: 'Google Ads — used to measure ad conversions.', duration: '90 days' },
  ],
  preferences: [
    { name: 'color-theme', purpose: 'Remembers your chosen colour theme.', duration: 'Session (sessionStorage)' },
  ],
};
---

<PageLayout
  title="Cookie Policy — Stacknxt Inc"
  description="How Stacknxt Inc uses cookies, what they're for, and how to control them."
  noindex
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="cookie" size="sm" />
      Legal
    </Badge>

    <h1 slot="title">Cookie Policy</h1>

    <p slot="description">
      Last updated: {lastUpdated}
    </p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6">
      <div class="prose prose-lg max-w-none" data-reveal>
        <p>
          This policy explains what cookies and similar technologies {siteConfig.name} uses on this website, why
          we use them, and how you can control them. It should be read alongside our <a href="/privacy">Privacy Policy</a>.
        </p>

        <h2>What are cookies?</h2>
        <p>
          Cookies are small text files placed on your device when you visit a website. Some cookies are essential
          for the site to work; others help us understand how the site is used, or remember your preferences. We
          also use similar technologies like <code>localStorage</code> and <code>sessionStorage</code> for the
          same purposes.
        </p>

        <h2>Managing your preferences</h2>
        <p>
          You can choose which categories of cookies to allow via the cookie banner shown on your first visit,
          and change your mind at any time using the button below.
        </p>
      </div>

      <div class="not-prose my-8">
        <Button id="reopen-consent-banner" variant="outline">
          <Icon name="settings" size="sm" />
          Manage cookie preferences
        </Button>
      </div>

      <div class="prose prose-lg max-w-none">
        <h2>Cookie categories we use</h2>
      </div>

      <div class="mt-6 flex flex-col gap-6">
        {categoryEntries.map(([key, category]) => (
          <div class="rounded-2xl border border-border bg-background-secondary p-6">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h3 class="font-display text-lg font-bold text-foreground m-0">{category.label}</h3>
              {category.required && <Badge variant="brand" size="sm">Always on</Badge>}
            </div>
            <p class="text-sm text-foreground-muted leading-relaxed mb-4">{category.description}</p>

            {exampleCookies[key] && exampleCookies[key].length > 0 && (
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-border text-left text-foreground-muted">
                      <th class="py-2 pr-4 font-semibold">Name</th>
                      <th class="py-2 pr-4 font-semibold">Purpose</th>
                      <th class="py-2 font-semibold">Duration</th>
                    </tr>
                  </thead>
                  <tbody>
                    {exampleCookies[key].map((cookie) => (
                      <tr class="border-b border-border/60 last:border-0">
                        <td class="py-2 pr-4 font-mono text-xs text-foreground">{cookie.name}</td>
                        <td class="py-2 pr-4 text-foreground-muted">{cookie.purpose}</td>
                        <td class="py-2 text-foreground-muted whitespace-nowrap">{cookie.duration}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="prose prose-lg max-w-none mt-10">
        <h2>Third-party cookies</h2>
        <p>
          Where analytics or marketing categories are enabled, cookies may be set by third-party services such as
          Google Analytics or Google Tag Manager. These providers have their own privacy and cookie policies,
          which govern how they process the data collected.
        </p>

        <h2>Browser controls</h2>
        <p>
          Most browsers let you block or delete cookies through their settings. Blocking essential cookies may
          affect how parts of the site function. For more detail, check your browser's help documentation.
        </p>

        <h2>Changes to this policy</h2>
        <p>
          We may update this Cookie Policy occasionally. The "Last updated" date at the top reflects the most
          recent revision.
        </p>

        <h2>Contact us</h2>
        <p>
          Questions about our use of cookies? Email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          or use our <a href="/contact">contact page</a>.
        </p>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  function initReopenConsentBanner() {
    const btn = document.getElementById('reopen-consent-banner');
    if (!btn || btn.dataset.init) return;
    btn.dataset.init = 'true';

    btn.addEventListener('click', () => {
      document.getElementById('consent-reopener')?.click();
    });
  }

  initReopenConsentBanner();
  document.addEventListener('astro:page-load', initReopenConsentBanner);
</script>
