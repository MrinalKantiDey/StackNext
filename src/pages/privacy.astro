---
/**
 * Privacy Policy page
 * URL: /privacy
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';
import consentConfig from '@/config/consent.config';

const lastUpdated = 'August 16, 2026';
const categories = Object.values(consentConfig.categories);
---

<PageLayout
  title="Privacy Policy — Stacknxt Inc"
  description="How Stacknxt Inc collects, uses, and protects your personal data."
  noindex
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="lock" size="sm" />
      Legal
    </Badge>

    <h1 slot="title">Privacy Policy</h1>

    <p slot="description">
      Last updated: {lastUpdated}
    </p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6">
      <div class="prose prose-lg max-w-none" data-reveal>
        <p>
          {siteConfig.name} ("we", "us", "our") respects your privacy and is committed to protecting the personal
          data you share with us. This policy explains what we collect, why we collect it, how we use it, and the
          choices you have.
        </p>

        <h2>Who we are</h2>
        <p>
          {siteConfig.name} is based in {siteConfig.address?.city}, {siteConfig.address?.country}. You can reach us
          at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> with any question about this policy or
          your personal data.
        </p>

        <h2>Information we collect</h2>
        <ul>
          <li><strong>Contact details</strong> you submit through our contact or newsletter forms — name, email address, and message content.</li>
          <li><strong>Usage data</strong> collected automatically when consent is given — pages visited, approximate location (country/city level), device and browser type, and referral source.</li>
          <li><strong>Cookies and similar technologies</strong>, described in full in our <a href="/cookies">Cookie Policy</a>.</li>
        </ul>

        <h2>How we use your information</h2>
        <ul>
          <li>To respond to enquiries submitted through our contact form.</li>
          <li>To send newsletter updates, only to people who have explicitly subscribed.</li>
          <li>To understand how our website is used, so we can improve it — only where you've consented to analytics.</li>
          <li>To meet legal, accounting, or security obligations.</li>
        </ul>
        <p>We do not sell your personal data, and we do not share it with third parties for their own marketing purposes.</p>

        <h2>Legal basis for processing</h2>
        <p>
          Where the General Data Protection Regulation (GDPR) applies, we rely on the following legal bases:
          <strong>consent</strong> (for analytics, marketing, and newsletter emails), <strong>contract</strong>
          (to respond to a project enquiry you initiate), and <strong>legitimate interest</strong> (for basic
          security and fraud prevention).
        </p>

        <h2>Cookie categories</h2>
        <p>Our cookie consent banner lets you control the following categories:</p>
        <ul>
          {categories.map((category) => (
            <li>
              <strong>{category.label}{category.required ? ' (required)' : ''}</strong> — {category.description}
            </li>
          ))}
        </ul>
        <p>See our <a href="/cookies">Cookie Policy</a> for the full list of cookies and how to change your preferences at any time.</p>

        <h2>Data retention</h2>
        <p>
          We keep contact form submissions for as long as needed to handle the enquiry and for a reasonable period
          afterward for record-keeping, then delete them. Newsletter subscriber data is kept until you unsubscribe.
          Analytics data, where enabled, is retained in aggregated or anonymised form.
        </p>

        <h2>Your rights</h2>
        <p>Depending on where you live, you may have the right to:</p>
        <ul>
          <li>Request a copy of the personal data we hold about you.</li>
          <li>Ask us to correct inaccurate data.</li>
          <li>Ask us to delete your data.</li>
          <li>Withdraw consent at any time, without affecting processing carried out before withdrawal.</li>
          <li>Object to or restrict certain processing.</li>
          <li>Lodge a complaint with your local data protection authority.</li>
        </ul>
        <p>
          To exercise any of these rights, email us at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
          We'll respond within a reasonable timeframe.
        </p>

        <h2>Third-party services</h2>
        <p>
          We may use third-party services for analytics, email delivery, and hosting. These providers only
          process data on our behalf and under our instructions, and are contractually required to protect it.
        </p>

        <h2>Children's privacy</h2>
        <p>Our website is not directed at children under 16, and we do not knowingly collect personal data from them.</p>

        <h2>Changes to this policy</h2>
        <p>
          We may update this policy from time to time. The "Last updated" date at the top of this page reflects
          the most recent revision. Material changes will be communicated where appropriate.
        </p>

        <h2>Contact us</h2>
        <p>
          Questions about this policy or your data? Email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          or use our <a href="/contact">contact page</a>.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
