---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import { getToolBySlug } from '@/config/tools.config';

const tool = getToolBySlug('color-converter')!;
---

<PageLayout title={`${tool.navLabel} — Free Tool | Stacknxt Inc`} description={tool.metaDescription} eagerReveal>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name={tool.navIcon} size="sm" />
      Free Tool
    </Badge>
    <h1 slot="title">{tool.navLabel}</h1>
    <p slot="description">Convert any colour between Hex, RGB, and OKLCH — with a live swatch preview.</p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6 flex flex-col gap-8">
      <Card variant="elevated" padding="lg" class="flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <input type="color" id="picker" value="#7c3aed" class="h-14 w-20 shrink-0 cursor-pointer rounded-xl border border-border bg-transparent" />
          <div class="flex-1">
            <label for="hex-input" class="text-sm font-medium text-foreground">Hex</label>
            <input type="text" id="hex-input" value="#7c3aed" class="mt-1 w-full rounded-lg border border-border-strong bg-background px-3 py-2 text-sm font-mono text-foreground" />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-border bg-background-secondary p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-foreground-muted mb-2">RGB</p>
            <p id="rgb-value" class="font-mono text-sm text-foreground">rgb(124, 58, 237)</p>
          </div>
          <div class="rounded-xl border border-border bg-background-secondary p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-foreground-muted mb-2">OKLCH</p>
            <p id="oklch-value" class="font-mono text-sm text-foreground">oklch(0.541 0.229 292.7)</p>
          </div>
        </div>
      </Card>

      <div class="prose prose-lg max-w-none">
        <h2>Why OKLCH</h2>
        <p>OKLCH describes colour in perceptually uniform lightness, chroma, and hue — two colours with the same lightness value look equally bright to the human eye, which Hex and RGB don't guarantee. It's the format this site's own design tokens are built on.</p>
      </div>

      <div class="text-center">
        <Button href="/tools" variant="outline">
          <Icon name="arrow-left" size="sm" />
          All free tools
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  function initColorConverter() {
    const picker = document.getElementById('picker') as HTMLInputElement;
    const hexInput = document.getElementById('hex-input') as HTMLInputElement;
    const rgbValue = document.getElementById('rgb-value') as HTMLParagraphElement;
    const oklchValue = document.getElementById('oklch-value') as HTMLParagraphElement;
    if (!picker || !hexInput || !rgbValue || !oklchValue) return;
    if (picker.dataset.init) return;
    picker.dataset.init = 'true';

    function isValidHex(hex: string): boolean {
      return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(hex);
    }

    function hexToRgb(hex: string): [number, number, number] {
      const h = hex.replace('#', '');
      const full = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
      return [0, 2, 4].map((i) => parseInt(full.slice(i, i + 2), 16)) as [number, number, number];
    }

    function srgbToOklch(r: number, g: number, b: number): [number, number, number] {
      const toLinear = (c: number) => {
        c /= 255;
        return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      };
      const lr = toLinear(r), lg = toLinear(g), lb = toLinear(b);

      const l = 0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb;
      const m = 0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb;
      const s = 0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb;

      const l_ = Math.cbrt(l), m_ = Math.cbrt(m), s_ = Math.cbrt(s);

      const L = 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_;
      const a = 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_;
      const bb = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_;

      const C = Math.sqrt(a * a + bb * bb);
      let H = (Math.atan2(bb, a) * 180) / Math.PI;
      if (H < 0) H += 360;

      return [L, C, H];
    }

    function update() {
      const hex = hexInput.value;
      if (!isValidHex(hex)) return;

      const [r, g, b] = hexToRgb(hex);
      rgbValue.textContent = `rgb(${r}, ${g}, ${b})`;

      const [L, C, H] = srgbToOklch(r, g, b);
      oklchValue.textContent = `oklch(${L.toFixed(3)} ${C.toFixed(3)} ${H.toFixed(1)})`;
    }

    picker.addEventListener('input', () => { hexInput.value = picker.value; update(); });
    hexInput.addEventListener('input', () => { if (isValidHex(hexInput.value)) picker.value = hexInput.value; update(); });

    update();
  }

  initColorConverter();
  document.addEventListener('astro:page-load', initColorConverter);
</script>
