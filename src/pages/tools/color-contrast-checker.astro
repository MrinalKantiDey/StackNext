---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import { getToolBySlug } from '@/config/tools.config';

const tool = getToolBySlug('color-contrast-checker')!;
---

<PageLayout title={`${tool.navLabel} — Free Tool | Stacknxt Inc`} description={tool.metaDescription} eagerReveal>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name={tool.navIcon} size="sm" />
      Free Tool
    </Badge>
    <h1 slot="title">{tool.navLabel}</h1>
    <p slot="description">Check the WCAG contrast ratio between any two colours — everything runs in your browser, nothing is uploaded.</p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6 flex flex-col gap-8">
      <Card variant="elevated" padding="lg" class="flex flex-col gap-6">
        <div class="grid gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="fg-color" class="text-sm font-medium text-foreground">Text colour</label>
            <div class="flex items-center gap-3">
              <input type="color" id="fg-color" value="#190655" class="h-10 w-14 shrink-0 cursor-pointer rounded-lg border border-border bg-transparent" />
              <input type="text" id="fg-hex" value="#190655" class="w-full rounded-lg border border-border-strong bg-background px-3 py-2 text-sm font-mono text-foreground" />
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <label for="bg-color" class="text-sm font-medium text-foreground">Background colour</label>
            <div class="flex items-center gap-3">
              <input type="color" id="bg-color" value="#ffffff" class="h-10 w-14 shrink-0 cursor-pointer rounded-lg border border-border bg-transparent" />
              <input type="text" id="bg-hex" value="#ffffff" class="w-full rounded-lg border border-border-strong bg-background px-3 py-2 text-sm font-mono text-foreground" />
            </div>
          </div>
        </div>

        <div id="preview-box" class="flex items-center justify-center rounded-xl border border-border p-8 text-center transition-colors">
          <div>
            <p id="preview-large" class="text-2xl font-bold">Large text sample</p>
            <p id="preview-normal" class="mt-1 text-sm">Normal body text sample — the quick brown fox jumps over the lazy dog.</p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-border bg-background-secondary p-5 text-center">
            <p class="text-xs font-semibold uppercase tracking-wider text-foreground-muted mb-1">Contrast ratio</p>
            <p id="ratio-value" class="font-display text-4xl font-bold text-foreground">21.00:1</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div id="aa-normal" class="rounded-xl border border-border bg-background-secondary p-3 text-center">
              <p class="text-xs font-semibold text-foreground-muted">AA normal</p>
              <p class="mt-1 text-sm font-bold">—</p>
            </div>
            <div id="aa-large" class="rounded-xl border border-border bg-background-secondary p-3 text-center">
              <p class="text-xs font-semibold text-foreground-muted">AA large</p>
              <p class="mt-1 text-sm font-bold">—</p>
            </div>
            <div id="aaa-normal" class="rounded-xl border border-border bg-background-secondary p-3 text-center">
              <p class="text-xs font-semibold text-foreground-muted">AAA normal</p>
              <p class="mt-1 text-sm font-bold">—</p>
            </div>
            <div id="aaa-large" class="rounded-xl border border-border bg-background-secondary p-3 text-center">
              <p class="text-xs font-semibold text-foreground-muted">AAA large</p>
              <p class="mt-1 text-sm font-bold">—</p>
            </div>
          </div>
        </div>
      </Card>

      <div class="prose prose-lg max-w-none">
        <h2>How this is calculated</h2>
        <p>Contrast ratio is calculated per the WCAG 2.x formula: relative luminance is computed for each colour, and the ratio between the lighter and darker luminance (plus 0.05) is taken. <strong>AA</strong> requires 4.5:1 for normal text and 3:1 for large text (18pt+, or 14pt+ bold). <strong>AAA</strong> requires 7:1 and 4.5:1 respectively.</p>
      </div>

      <div class="text-center">
        <Button href="/tools" variant="outline">
          <Icon name="arrow-left" size="sm" />
          All free tools
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  function initContrastChecker() {
    const fgColor = document.getElementById('fg-color') as HTMLInputElement;
    const fgHex = document.getElementById('fg-hex') as HTMLInputElement;
    const bgColor = document.getElementById('bg-color') as HTMLInputElement;
    const bgHex = document.getElementById('bg-hex') as HTMLInputElement;
    const previewBox = document.getElementById('preview-box') as HTMLDivElement;
    const ratioValue = document.getElementById('ratio-value') as HTMLParagraphElement;
    if (!fgColor || !fgHex || !bgColor || !bgHex || !previewBox || !ratioValue) return;
    if (fgColor.dataset.init) return;
    fgColor.dataset.init = 'true';

    function isValidHex(hex: string): boolean {
      return /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(hex);
    }

    function relLuminance(hex: string): number {
      const h = hex.replace('#', '');
      const full = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
      const rgb = [0, 2, 4].map((i) => parseInt(full.slice(i, i + 2), 16) / 255);
      const [r, g, b] = rgb.map((c) => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4)));
      return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    }

    function setResult(id: string, pass: boolean) {
      const el = document.getElementById(id);
      if (!el) return;
      const p = el.querySelector('p:last-child');
      if (p) {
        p.textContent = pass ? 'Pass' : 'Fail';
        p.className = `mt-1 text-sm font-bold ${pass ? 'text-success' : 'text-destructive'}`;
      }
    }

    function update() {
      const fg = fgHex.value;
      const bg = bgHex.value;
      if (!isValidHex(fg) || !isValidHex(bg)) return;

      const l1 = relLuminance(fg);
      const l2 = relLuminance(bg);
      const lighter = Math.max(l1, l2);
      const darker = Math.min(l1, l2);
      const ratio = (lighter + 0.05) / (darker + 0.05);

      ratioValue.textContent = `${ratio.toFixed(2)}:1`;
      previewBox.style.backgroundColor = bg;
      previewBox.style.color = fg;

      setResult('aa-normal', ratio >= 4.5);
      setResult('aa-large', ratio >= 3);
      setResult('aaa-normal', ratio >= 7);
      setResult('aaa-large', ratio >= 4.5);
    }

    fgColor.addEventListener('input', () => { fgHex.value = fgColor.value; update(); });
    bgColor.addEventListener('input', () => { bgHex.value = bgColor.value; update(); });
    fgHex.addEventListener('input', () => { if (isValidHex(fgHex.value)) fgColor.value = fgHex.value; update(); });
    bgHex.addEventListener('input', () => { if (isValidHex(bgHex.value)) bgColor.value = bgHex.value; update(); });

    update();
  }

  initContrastChecker();
  document.addEventListener('astro:page-load', initContrastChecker);
</script>
