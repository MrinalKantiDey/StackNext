---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Input from '@/components/ui/form/Input/Input.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import { Hero } from '@/components/hero';
import CopyableOutput from '@/components/tools/CopyableOutput.astro';
import { getToolBySlug } from '@/config/tools.config';

const tool = getToolBySlug('robots-txt-generator')!;
---

<PageLayout title={`${tool.navLabel} — Free Tool | Stacknxt Inc`} description={tool.metaDescription} eagerReveal>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name={tool.navIcon} size="sm" />
      Free Tool
    </Badge>
    <h1 slot="title">{tool.navLabel}</h1>
    <p slot="description">Allow or disallow crawlers, add a sitemap URL, and copy a ready-to-use robots.txt.</p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6 flex flex-col gap-8">
      <Card variant="elevated" padding="lg" class="flex flex-col gap-5">
        <label class="flex items-center gap-2 text-sm font-medium text-foreground">
          <input type="checkbox" id="allow-all" checked class="h-4 w-4 rounded border-border-strong accent-brand-500" />
          Allow all crawlers by default
        </label>

        <Textarea
          id="disallow-paths"
          label="Disallow paths (one per line)"
          rows={4}
          placeholder={'/admin/\n/api/\n/*.pdf$'}
        />

        <Textarea
          id="allow-paths"
          label="Explicitly allow paths (optional, one per line)"
          rows={2}
          placeholder="/api/public/"
        />

        <Input id="sitemap-url" label="Sitemap URL (optional)" placeholder="https://yoursite.com/sitemap-index.xml" />

        <CopyableOutput id="robots-output" minHeight="8rem" />
      </Card>

      <div class="text-center">
        <Button href="/tools" variant="outline">
          <Icon name="arrow-left" size="sm" />
          All free tools
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  function initRobotsGenerator() {
    const allowAll = document.getElementById('allow-all') as HTMLInputElement;
    const disallowPaths = document.getElementById('disallow-paths') as HTMLTextAreaElement;
    const allowPaths = document.getElementById('allow-paths') as HTMLTextAreaElement;
    const sitemapUrl = document.getElementById('sitemap-url') as HTMLInputElement;
    const output = document.getElementById('robots-output') as HTMLElement;
    if (!allowAll || !disallowPaths || !allowPaths || !sitemapUrl || !output) return;
    if (allowAll.dataset.init) return;
    allowAll.dataset.init = 'true';

    function linesOf(el: HTMLTextAreaElement): string[] {
      return el.value.split('\n').map((l) => l.trim()).filter(Boolean);
    }

    function update() {
      const lines = ['User-agent: *'];

      if (!allowAll.checked) {
        lines.push('Disallow: /');
      } else {
        linesOf(disallowPaths).forEach((p) => lines.push(`Disallow: ${p}`));
        linesOf(allowPaths).forEach((p) => lines.push(`Allow: ${p}`));
        if (linesOf(disallowPaths).length === 0 && linesOf(allowPaths).length === 0) {
          lines.push('Disallow:');
        }
      }

      if (sitemapUrl.value.trim()) {
        lines.push('');
        lines.push(`Sitemap: ${sitemapUrl.value.trim()}`);
      }

      output.textContent = lines.join('\n');
    }

    [allowAll, disallowPaths, allowPaths, sitemapUrl].forEach((el) => el.addEventListener('input', update));
    update();
  }

  initRobotsGenerator();
  document.addEventListener('astro:page-load', initRobotsGenerator);
</script>
