---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import { Hero } from '@/components/hero';
import CopyableOutput from '@/components/tools/CopyableOutput.astro';
import { getToolBySlug } from '@/config/tools.config';

const tool = getToolBySlug('text-case-converter')!;

const cases = [
  { id: 'upper', label: 'UPPERCASE' },
  { id: 'lower', label: 'lowercase' },
  { id: 'title', label: 'Title Case' },
  { id: 'sentence', label: 'Sentence case' },
  { id: 'camel', label: 'camelCase' },
  { id: 'pascal', label: 'PascalCase' },
  { id: 'snake', label: 'snake_case' },
  { id: 'kebab', label: 'kebab-case' },
];
---

<PageLayout title={`${tool.navLabel} — Free Tool | Stacknxt Inc`} description={tool.metaDescription} eagerReveal>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name={tool.navIcon} size="sm" />
      Free Tool
    </Badge>
    <h1 slot="title">{tool.navLabel}</h1>
    <p slot="description">Convert text between UPPERCASE, lowercase, Title Case, camelCase, snake_case, and more.</p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6 flex flex-col gap-8">
      <Card variant="elevated" padding="lg" class="flex flex-col gap-6">
        <Textarea id="text-input" label="Your text" rows={5} placeholder="Type or paste text here…" />

        <div class="flex flex-wrap gap-2">
          {cases.map((c) => (
            <button type="button" data-case={c.id} class="case-btn rounded-full border border-border-strong px-4 py-1.5 text-sm font-medium text-foreground-muted transition-colors hover:border-brand-500 hover:text-foreground">
              {c.label}
            </button>
          ))}
        </div>

        <CopyableOutput id="case-output" placeholder="Converted text will appear here." />
      </Card>

      <div class="text-center">
        <Button href="/tools" variant="outline">
          <Icon name="arrow-left" size="sm" />
          All free tools
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  function initCaseConverter() {
    const input = document.getElementById('text-input') as HTMLTextAreaElement;
    const output = document.getElementById('case-output') as HTMLElement;
    const buttons = document.querySelectorAll<HTMLButtonElement>('.case-btn');
    if (!input || !output || buttons.length === 0) return;
    if (input.dataset.init) return;
    input.dataset.init = 'true';

    function words(text: string): string[] {
      return text
        .trim()
        .replace(/([a-z])([A-Z])/g, '$1 $2')
        .split(/[\s_-]+/)
        .filter(Boolean);
    }

    function convert(text: string, type: string): string {
      const w = words(text);
      switch (type) {
        case 'upper': return text.toUpperCase();
        case 'lower': return text.toLowerCase();
        case 'title': return w.map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ');
        case 'sentence': {
          const lower = text.toLowerCase().trim();
          return lower.charAt(0).toUpperCase() + lower.slice(1);
        }
        case 'camel': return w.map((word, i) => i === 0 ? word.toLowerCase() : word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join('');
        case 'pascal': return w.map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join('');
        case 'snake': return w.map((word) => word.toLowerCase()).join('_');
        case 'kebab': return w.map((word) => word.toLowerCase()).join('-');
        default: return text;
      }
    }

    let activeCase = 'upper';

    function update() {
      output.textContent = input.value.trim() ? convert(input.value, activeCase) : 'Converted text will appear here.';
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCase = btn.dataset.case || 'upper';
        buttons.forEach((b) => b.classList.remove('border-brand-500', 'text-foreground'));
        btn.classList.add('border-brand-500', 'text-foreground');
        update();
      });
    });

    input.addEventListener('input', update);
    buttons[0]?.classList.add('border-brand-500', 'text-foreground');
  }

  initCaseConverter();
  document.addEventListener('astro:page-load', initCaseConverter);
</script>
