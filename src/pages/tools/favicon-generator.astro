---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Input from '@/components/ui/form/Input/Input.astro';
import Select from '@/components/ui/form/Select/Select.astro';
import { Hero } from '@/components/hero';
import { getToolBySlug } from '@/config/tools.config';

const tool = getToolBySlug('favicon-generator')!;
---

<PageLayout title={`${tool.navLabel} — Free Tool | Stacknxt Inc`} description={tool.metaDescription} eagerReveal>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name={tool.navIcon} size="sm" />
      Free Tool
    </Badge>
    <h1 slot="title">{tool.navLabel}</h1>
    <p slot="description">Pick a letter, colour, and shape — preview live and download an SVG favicon.</p>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-3xl px-6 flex flex-col gap-8">
      <Card variant="elevated" padding="lg" class="flex flex-col gap-6">
        <div class="flex justify-center">
          <div id="preview-wrap" class="flex h-32 w-32 items-center justify-center bg-brand-500 text-5xl font-bold text-white">
            A
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <Input id="letter" label="Letter(s)" maxlength="2" value="A" />
          <Select
            id="shape"
            label="Shape"
            options={[
              { value: 'circle', label: 'Circle' },
              { value: 'rounded', label: 'Rounded square' },
              { value: 'square', label: 'Square' },
            ]}
          />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="bg-color" class="text-sm font-medium text-foreground">Background colour</label>
            <input type="color" id="bg-color" value="#190655" class="h-10 w-full cursor-pointer rounded-lg border border-border bg-transparent" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="text-color" class="text-sm font-medium text-foreground">Text colour</label>
            <input type="color" id="text-color" value="#ffffff" class="h-10 w-full cursor-pointer rounded-lg border border-border bg-transparent" />
          </div>
        </div>

        <Button id="download-btn" type="button" class="self-center gap-2">
          <Icon name="download" size="sm" />
          Download SVG
        </Button>
      </Card>

      <div class="text-center">
        <Button href="/tools" variant="outline">
          <Icon name="arrow-left" size="sm" />
          All free tools
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  function initFaviconGenerator() {
    const letter = document.getElementById('letter') as HTMLInputElement;
    const shape = document.getElementById('shape') as HTMLSelectElement;
    const bgColor = document.getElementById('bg-color') as HTMLInputElement;
    const textColor = document.getElementById('text-color') as HTMLInputElement;
    const previewWrap = document.getElementById('preview-wrap') as HTMLDivElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
    if (!letter || !shape || !bgColor || !textColor || !previewWrap || !downloadBtn) return;
    if (downloadBtn.dataset.init) return;
    downloadBtn.dataset.init = 'true';

    const radiusFor: Record<string, string> = { circle: '9999px', rounded: '24%', square: '0' };

    function buildSvg(): string {
      const text = (letter.value || 'A').slice(0, 2).toUpperCase();
      const rx = shape.value === 'circle' ? 256 : shape.value === 'rounded' ? 96 : 0;
      return `<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <rect width="512" height="512" rx="${rx}" fill="${bgColor.value}" />
  <text x="256" y="256" text-anchor="middle" dominant-baseline="central" font-family="system-ui, sans-serif" font-size="240" font-weight="700" fill="${textColor.value}">${text}</text>
</svg>`;
    }

    function update() {
      previewWrap.textContent = (letter.value || 'A').slice(0, 2).toUpperCase();
      previewWrap.style.backgroundColor = bgColor.value;
      previewWrap.style.color = textColor.value;
      previewWrap.style.borderRadius = radiusFor[shape.value] || '0';
    }

    downloadBtn.addEventListener('click', () => {
      const svg = buildSvg();
      const blob = new Blob([svg], { type: 'image/svg+xml' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'favicon.svg';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    [letter, shape, bgColor, textColor].forEach((el) => el.addEventListener('input', update));
    update();
  }

  initFaviconGenerator();
  document.addEventListener('astro:page-load', initFaviconGenerator);
</script>
