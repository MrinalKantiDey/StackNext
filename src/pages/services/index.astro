---
/**
 * Services hub page
 * URL: /services
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import { Hero } from '@/components/hero';
import { services, processSteps } from '@/config/services.config';
---

<PageLayout
  title="Services — Stacknxt Inc"
  description="Web design, development, e-commerce, performance, support, and consulting — one consistent standard, from the first wireframe to the final Lighthouse score."
  eagerReveal
>
  <Hero layout="centered" size="md" showGlow>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      What We Offer
    </Badge>

    <h1 slot="title">
      Services — designed, built, and <span class="text-brand-500">tuned.</span>
    </h1>

    <p slot="description">
      Six core services, one consistent standard. From the first wireframe to the final Lighthouse score, every project gets the same attention to detail.
    </p>
  </Hero>

  <!-- Services grid -->
  <section class="relative overflow-hidden py-[var(--space-section-md)] border-t border-border bg-background-secondary">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service, i) => (
          <Card
            variant="elevated"
            padding="lg"
            href={`/services/${service.slug}`}
            hover
            data-reveal
            data-reveal-delay={i % 3}
            class="group flex flex-col gap-4"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 text-brand-500">
              <Icon name={service.navIcon} size="md" />
            </div>
            <div class="flex flex-col gap-2">
              <h2 class="font-display text-xl font-bold text-foreground">
                {service.navLabel}
              </h2>
              <p class="text-sm text-foreground-muted leading-relaxed">
                {service.shortDescription}
              </p>
            </div>
            <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-brand-500">
              Explore {service.navLabel}
              <Icon name="arrow-right" size="sm" class="transition-transform group-hover:translate-x-1" />
            </span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12 text-center flex flex-col items-center gap-4" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>How It Works</Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            A clear, honest process
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          Four stages, one point of contact, no surprises.
        </p>
      </div>

      <div class="relative grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="pointer-events-none absolute inset-x-0 top-11 hidden h-px bg-border lg:block" aria-hidden="true" />
        {processSteps.map((step, i) => (
          <div class="relative flex flex-col items-center gap-4 text-center lg:items-start lg:text-left" data-reveal data-reveal-delay={i}>
            <div class="relative z-10 flex h-[3.75rem] w-[3.75rem] shrink-0 items-center justify-center rounded-2xl border border-border bg-background text-brand-500 shadow-sm">
              <Icon name={step.icon} size="md" />
              <span class="absolute -right-1.5 -top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-brand-500 text-[10px] font-bold text-white">
                {i + 1}
              </span>
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">{step.title}</h3>
              <p class="mt-1.5 text-sm text-foreground-muted leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTA variant="default" size="lg" maxWidth="lg">
    <h2 slot="heading">Let's talk</h2>
    <Fragment slot="description">
      <p class="font-semibold text-foreground">Have a project in mind?</p>
      <p>Send a short note about what you're building and what you need. We read every message and reply within a working day.</p>
    </Fragment>
    <Fragment slot="actions">
      <Button size="lg" href="/contact">
        Start a project
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href="/about">
        More about us
      </Button>
    </Fragment>
  </CTA>
</PageLayout>
