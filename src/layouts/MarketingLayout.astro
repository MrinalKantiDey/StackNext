---
/**
 * MarketingLayout
 * Layout wrapper for marketing pages with floating capsule header
 * Uses Header shape="floating" for a distinctive visual identity
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getFooterLinkGroups, footerSocialLinks } from '@/config/nav.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
>
  <Header
    slot="header"
    shape="bar"
    variant="solid"
    position="fixed"
    colorScheme="default"
    showCta={true}
    cta={{ label: 'Book a Demo', href: '/contact', trailingIcon: 'arrow-right' }}
  />

  <slot />

  <Footer
    slot="footer"
    layout="columns"
    columns={5}
    background="secondary"
    linkGroups={getFooterLinkGroups()}
    socialLinks={footerSocialLinks}
    tagline="A full-service software development studio — design, build, and support, under one roof."
  />
</BaseLayout>
