---
import type { ImageMetadata, MarkdownHeading } from 'astro';
import siteConfig from '@/config/site.config';
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import ArticleHero from '@/components/blog/ArticleHero.astro';
import ShareButtons from '@/components/blog/ShareButtons.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import AuthorAvatar from '@/components/blog/AuthorAvatar.astro';
import TableOfContents from '@/components/ui/content/TableOfContents';
import { resolveSocialLinks } from '@/lib/utils';

const socialLinks = resolveSocialLinks(siteConfig.socialLinks);

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author?: string;
  authorAvatar?: ImageMetadata;
  image?: ImageMetadata;
  imageAlt?: string;
  svgSlug?: string;
  tags?: string[];
  slug?: string;
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author = 'Team',
  authorAvatar,
  image,
  imageAlt,
  svgSlug,
  tags = [],
  slug = '',
  headings = [],
} = Astro.props;

const ogImage = image?.src || siteConfig.ogImage;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title },
];

// Get full URL for sharing
const fullUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Council-post-style byline formatting (e.g. "Published May 15, 2026, 09:30am EDT")
const councilDate = publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const councilTime = publishedAt
  .toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true })
  .toLowerCase()
  .replace(/\s/g, '');
const councilDateLine = `Published ${councilDate}, ${councilTime} EDT`;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={imageAlt || title}
  article={{
    publishedTime: publishedAt,
    modifiedTime: updatedAt,
    authors: [author],
    tags,
  }}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showCta={true}
    cta={{ label: 'Book a Demo', href: '/contact', trailingIcon: 'arrow-right' }}
    showScrollProgress
  />

  <div class="min-h-screen pt-16">
  <!-- Article Hero -->
  <ArticleHero
    title={title}
    description={description}
    publishedAt={publishedAt}
    updatedAt={updatedAt}
    author={author}
    authorAvatar={authorAvatar}
    tags={tags}
    image={image}
    imageAlt={imageAlt}
    svgSlug={svgSlug}
  />

  <article class="pt-8 pb-[var(--space-section-md)]">
    <div class="mx-auto max-w-5xl px-6">
      <!-- Breadcrumbs -->
      <Breadcrumbs items={breadcrumbs} class="mb-8" />

      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:items-start lg:gap-12">
        <div class="min-w-0">
          <!-- Council-post-style byline -->
          <aside class="council-byline mb-10 flex items-start gap-4 rounded-2xl border border-border bg-background-secondary px-5 py-4" data-reveal>
            <div class="shrink-0 rounded-full ring-2 ring-border">
              <AuthorAvatar name={author} avatar={authorAvatar} size="md" />
            </div>
            <div class="flex-1 min-w-0 text-sm text-foreground-muted leading-relaxed">
              <p>
                By <a href="/about" class="font-semibold text-foreground underline decoration-foreground-subtle underline-offset-2 hover:decoration-brand-500">{author}</a>,
                <span class="text-foreground">StackRocket Council Member.</span>
              </p>
              <p>
                for <a href="/about" class="text-foreground underline decoration-foreground-subtle underline-offset-2 hover:decoration-brand-500">StackRocket Technology Council</a>,
                <span class="font-semibold text-brand-500 uppercase tracking-wide">Council Post</span>
                <span class="text-foreground-subtle">|</span>
                <span>Membership (fee-based)</span>
              </p>
              <p class="mt-2 text-foreground-subtle">
                <time datetime={publishedAt.toISOString()}>{councilDateLine}</time>
              </p>
            </div>
          </aside>

          <!-- Article Content -->
          <div
            class="prose prose-lg max-w-none"
            data-reveal-content
          >
            <slot />
          </div>

          <!-- Article Footer -->
          <footer class="border-border mt-12 border-t pt-8" data-reveal>
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
              <!-- Back link -->
              <a
                href="/blog"
                class="text-brand-600 hover:text-brand-500 dark:text-brand-400 dark:hover:text-brand-300 inline-flex items-center gap-2 text-sm font-medium transition-colors"
              >
                <svg
                  class="h-4 w-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"
                  ></path>
                </svg>
                Back to Blog
              </a>

              <!-- Share buttons -->
              <ShareButtons title={title} url={fullUrl} />
            </div>
          </footer>
        </div>

        <TableOfContents headings={headings} class="hidden lg:block" />
      </div>
    </div>
  </article>

  <!-- Related Posts -->
  {tags.length > 0 && (
    <div class="mx-auto max-w-screen-xl px-6" data-reveal>
      <RelatedPosts currentSlug={slug} tags={tags} locale="en" maxPosts={3} />
    </div>
  )}

  <!-- Follow Along -->
  <CTA variant="default" size="md" maxWidth="lg" glow={false} data-reveal class="bg-background-secondary">
    <h2 slot="heading" class="!text-4xl">Follow along</h2>
    <p slot="description" class="!text-lg text-balance">Stay in the loop — new articles, thoughts, and updates.</p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-500 hover:text-brand-500"
      >
        <Icon name="rss" size="sm" />
        RSS Feed
      </a>
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-500 hover:text-brand-500"
        >
          <Icon name={link.icon} size="sm" />
          {link.label}
        </a>
      ))}
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-500 hover:text-brand-500"
      >
        <Icon name="mail" size="sm" />
        Email
      </a>
    </div>
  </CTA>
  </div>

  <Footer slot="footer" layout="simple" background="secondary" />
</BaseLayout>
